PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kiptaaaz_db
JWT_SECRET=your_jwt_secret_key

# ============ EMAIL CONFIGURATION ============
# Choose one of the options below and configure the SMTP settings

# OPTION 1: Gmail SMTP (Recommended for development)
# Steps:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Google will generate a 16-character App Password
# 5. Use that password below (spaces will be removed automatically by Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# OPTION 2: Mailtrap (Recommended for testing)
# Steps:
# 1. Sign up free at https://mailtrap.io
# 2. Create a new inbox (e.g., "Development")
# 3. Go to "Integrations" > "Nodemailer"
# 4. Copy the Host, Port, User, and Pass values from Mailtrap
# Uncomment the lines below and comment out Gmail lines above:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_user_id
# SMTP_PASS=your_mailtrap_app_password

# Email display settings
FROM_NAME=Kiptaaz
FROM_EMAIL=no-reply@kiptaaaz.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
